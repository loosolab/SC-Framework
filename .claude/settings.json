      "Bash(git branch --show-current)",
      "Bash(conda env list)",
      "Bash(conda run -n sctoolbox ruff check --preview .)",
      "Bash(conda run -n sctoolbox ruff --version)",
      "Bash(conda run -n sctoolbox python -m pytest:*)",
      "Bash(conda run -n sctoolbox python -c \"import sctoolbox\")",
      "Bash(conda run -n sctoolbox python -c \"import sphinx\")",
      "Bash(conda run -n sctoolbox codespell --version)",
      "Bash(conda run -n sctoolbox codespell --toml pyproject.toml:*)",
      "Bash(conda run -n sctoolbox make -C docs html)",
      "Bash(conda run -n sctoolbox sphinx-build -b dummy docs/source /tmp/scdocs:*)",
      "Bash(conda run -n sctoolbox jupyter nbconvert --to notebook --execute:*)",
      "Bash(python3 scripts/add_change.py:*)",
      "Bash(python3 scripts/finalize_release.py:*)",
      "Bash(conda run -n sctoolbox python scripts/gitlab_query.py:*)",
      "Bash(conda run -n sctoolbox python scripts/check_dev_env.py:*)",
      "Edit(tests/**)",
      "Write(tests/**)",
      "Edit(src/sctoolbox/**)",
      "Write(src/sctoolbox/**)",
      "Edit(docs/**)",
      "Write(docs/**)",
      "Edit(CHANGES.md)",
      "Edit(pyproject.toml)",
      "Edit(.work/**)",
      "Write(.work/**)"
